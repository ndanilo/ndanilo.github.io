---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .slice(0, 3);
---

<BaseLayout
  title="Home"
  description="Technical portfolio, project writeups, and engineering notes by Danilo."
>
  <section class="hero">
    <div>
      <p class="eyebrow">Technical portfolio</p>
      <h1>Build, write, share, repeat.</h1>
      <p class="lead">
        A professional home for technical articles, project case studies, and practical
        engineering notes. The goal is to support LinkedIn content with a deeper website
        and a public GitHub presence.
      </p>
      <div class="actions">
        <a class="button" href="/posts/">Read the writing</a>
        <a class="button secondary" href="/projects/">View projects</a>
      </div>
    </div>
    <aside class="panel" aria-label="Portfolio strategy">
      <p class="eyebrow">Positioning loop</p>
      <ul>
        <li>Publish useful technical notes on the website.</li>
        <li>Share the short version on LinkedIn.</li>
        <li>Point readers to GitHub for implementation details.</li>
        <li>Build authority through consistent, practical content.</li>
      </ul>
    </aside>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Featured Projects</h2>
      <a href="/projects/">See all projects</a>
    </div>
    <div class="grid">
      {
        projects.map((project) => (
          <article class="card">
            <p class="eyebrow">{project.data.role}</p>
            <h3>{project.data.title}</h3>
            <p>{project.data.description}</p>
            <div class="tag-list">
              {project.data.stack.map((item) => <span class="tag">{item}</span>)}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Latest Writing</h2>
      <a href="/posts/">See all posts</a>
    </div>
    <div class="grid">
      {
        posts.map((post) => (
          <article class="card">
            <p class="meta">
              <time datetime={post.data.publishDate.toISOString()}>
                {post.data.publishDate.toLocaleDateString('en', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric',
                })}
              </time>
            </p>
            <h3>
              <a href={`/posts/${post.id}/`}>{post.data.title}</a>
            </h3>
            <p>{post.data.description}</p>
            <div class="tag-list">
              {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
