---
import { getCollection, render } from 'astro:content';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import BaseLayout from '@layouts/BaseLayout.astro';
import PostDemoVideo from '@components/PostDemoVideo.astro';

const DEMO_MARKER = '<!-- demo-video -->';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;

const formattedDate = post.data.publishDate.toLocaleDateString('en', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const demoSrc = post.data.demoVideo;
const demoTitle =
  post.data.demoVideoTitle ?? 'Pipeline demo';
const body = post.body ?? '';
const wantsInlineDemo = Boolean(demoSrc) && body.includes(DEMO_MARKER);

let beforeHtml = '';
let afterHtml = '';
let Content: Awaited<ReturnType<typeof render>>['Content'] | null = null;

if (wantsInlineDemo && demoSrc) {
  const [before, after = ''] = body.split(DEMO_MARKER);
  const processor = await createMarkdownProcessor();
  beforeHtml = (await processor.render(before)).code;
  afterHtml = (await processor.render(after)).code;
} else {
  ({ Content } = await render(post));
}
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div class="container">

    <header class="article-header">
      <a class="article-header__back" href="/posts/">
        Back to writing
      </a>

      <p class="article-header__eyebrow">Article</p>

      <h1 class="article-header__title">{post.data.title}</h1>

      <p class="article-header__description">{post.data.description}</p>

      <div class="article-header__meta">
        <time class="article-header__date" datetime={post.data.publishDate.toISOString()}>
          {formattedDate}
        </time>
        <div class="tag-list" aria-label="Post tags">
          {post.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      </div>
    </header>

    <div class="prose" role="main">
      {wantsInlineDemo && demoSrc ? (
        <>
          <Fragment set:html={beforeHtml} />
          <PostDemoVideo src={demoSrc} title={demoTitle} />
          <Fragment set:html={afterHtml} />
        </>
      ) : (
        Content && <Content />
      )}
    </div>

    <footer style="padding: 4rem 0 2rem;">
      <hr class="divider" style="margin: 0 0 3rem;" />
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
        <a class="btn btn--ghost" href="/posts/">&larr; All posts</a>
        <a
          class="btn btn--primary"
          href="https://www.linkedin.com/in/ndanilo-software-enginner/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Follow on LinkedIn
        </a>
      </div>
    </footer>

  </div>
</BaseLayout>
