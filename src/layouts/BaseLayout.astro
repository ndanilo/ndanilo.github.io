---
import '@styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = `${title} | Danilo Novais`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Danilo Novais" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>

    <!-- ============================================================
         SITE HEADER
         - .site-header: sticky bar with blur backdrop
         - .site-header__inner: flex row, brand left / nav right
         - Add/remove nav items in the <nav> below
         ============================================================ -->
    <header class="site-header" role="banner">
      <div class="container site-header__inner">

        <!-- Brand -->
        <a class="site-header__brand" href="/" aria-label="Danilo Novais — home">
          <span class="site-header__name">Danilo Novais</span>
          <span class="site-header__sub">Software Engineer</span>
        </a>

        <!-- Primary navigation -->
        <nav class="site-header__nav" aria-label="Main navigation">
          <a href="/projects/" class="nav-hide-mobile">Projects</a>
          <a href="/posts/" class="nav-hide-mobile">Writing</a>
          <a
            href="https://github.com/ndanilo"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-hide-mobile"
            aria-label="GitHub profile (opens in new tab)"
          >
            GitHub
          </a>
          <a
            href="https://www.linkedin.com/in/ndanilo-software-enginner/"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-cta"
            aria-label="LinkedIn profile (opens in new tab)"
          >
            LinkedIn
          </a>
        </nav>

      </div>
    </header>

    <!-- Page content -->
    <main id="main-content">
      <slot />
    </main>

    <!-- ============================================================
         SITE FOOTER
         - Edit copyright year and links below
         ============================================================ -->
    <footer class="site-footer" role="contentinfo">
      <div class="container site-footer__inner">
        <p class="site-footer__copy">
          &copy; {new Date().getFullYear()} Danilo Novais
        </p>
        <nav class="site-footer__links" aria-label="Footer navigation">
          <a href="/posts/">Writing</a>
          <a href="/projects/">Projects</a>
          <a
            href="https://github.com/ndanilo"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
          <a
            href="https://www.linkedin.com/in/ndanilo-software-enginner/"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </a>
        </nav>
      </div>
    </footer>

  </body>
</html>
